// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum SurveyStatus {
  live
  paused
}

/// Merchant survey definition: editor document JSON + list/publish scalars.
model Survey {
  id              String         @id @default(cuid())
  shop            String
  name            String
  status          SurveyStatus   @default(paused)
  surveyType      String         @default("survey")
  templateType    String         @default("blank")
  isActive        Boolean        @default(false)
  document        Json
  documentVersion Int            @default(1)
  responseCount   Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  responses       SurveyResponse[]

  @@index([shop, status])
  @@index([shop, updatedAt])
  @@index([shop, name])
}

/// One submission per shop + order + survey; questions + Shopify context as JSON.
model SurveyResponse {
  id           String    @id @default(cuid())
  shop         String
  surveyId     String
  surveyName   String
  surveyType   String    @default("survey")
  orderId      String
  customerId   String?
  pageType     String?
  channelType  String?
  questions    Json
  meta         Json?
  payload      Json?
  shopSequence Int?
  isArchived   Boolean   @default(false)
  archivedAt   DateTime?
  submittedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Restrict)

  @@unique([shop, orderId, surveyId])
  @@index([shop, submittedAt])
  @@index([shop, surveyId, submittedAt])
  @@index([shop, orderId])
  @@index([shop, customerId])
}
