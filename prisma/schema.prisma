// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Installed store tenant (one row per myshopify domain).
model Shop {
  id              BigInt   @id @default(autoincrement())
  shopUuid        String   @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  myshopifyDomain String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  surveys   Survey[]
  responses SurveyResponse[]
}

/// Shopify OAuth session storage (required shape for PrismaSessionStorage).
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum SurveyStatus {
  live
  paused
}

/// Merchant survey definition: editor document JSON + list/publish scalars.
model Survey {
  id              BigInt         @id @default(autoincrement())
  surveyUuid      String         @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  shopId          BigInt
  name            String
  status          SurveyStatus   @default(paused)
  surveyType      String         @default("survey")
  templateType    String         @default("blank")
  isActive        Boolean        @default(false)
  document        Json
  documentVersion Int            @default(1)
  responseCount   Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  shop      Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  @@index([shopId, status])
  @@index([shopId, updatedAt])
  @@index([shopId, name])
}

/// One submission per shop + order + survey; questions + Shopify context as JSON.
model SurveyResponse {
  id           BigInt    @id @default(autoincrement())
  responseUuid String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  shopId       BigInt
  surveyId     BigInt
  surveyName   String
  surveyType   String    @default("survey")
  orderId      String
  customerId   String?
  email        String?
  pageType     String?
  channelType  String?
  questions    Json
  meta         Json?
  payload      Json?
  shopSequence Int?
  isArchived   Boolean   @default(false)
  archivedAt   DateTime?
  submittedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Restrict)

  @@unique([shopId, orderId, surveyId])
  @@index([shopId, submittedAt])
  @@index([shopId, surveyId, submittedAt])
  @@index([shopId, orderId])
  @@index([shopId, customerId])
  @@index([shopId, email])
}
