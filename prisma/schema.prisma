// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// Per-shop survey configuration. One config row per shop (multi-tenancy).
model SurveyConfig {
  id         String         @id @default(cuid())
  shop       String         @unique
  question   String         @default("How did you hear about us?")
  isActive   Boolean        @default(true)
  allowOther Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  options    SurveyOption[]
}

/// Answer choices belonging to a shop's SurveyConfig.
model SurveyOption {
  id         String       @id @default(cuid())
  configId   String
  label      String
  orderIndex Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  config     SurveyConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
}

/// Immutable customer survey submission, scoped by shop + order.
model SurveyResponse {
  id             String   @id @default(cuid())
  shop           String
  orderId        String
  selectedOption String
  customText     String?
  customerId     String?
  createdAt      DateTime @default(now())

  @@unique([shop, orderId])
  @@index([shop, createdAt])
}
